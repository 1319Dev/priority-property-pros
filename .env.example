# Priority Property Pros — environment
# Copy this file to .env.local on your computer:
#   cp .env.example .env.local
#
# PUBLIC vs SERVER-ONLY
# ---------------------
# PUBLIC (safe in the website, GitHub Actions *variables*, never treat as a password):
#   VITE_PUBLIC_* and VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# SERVER-ONLY (never put in this repo, never in Vite, never in GitHub Pages):
#   SUPABASE_SERVICE_ROLE_KEY, database password, Stripe secret keys
#
# The anon key is designed to be public. Row Level Security is what protects data.

# Public app labels
VITE_PUBLIC_APP_NAME=Priority Property Pros
VITE_PUBLIC_COMPANY_NAME=PRIORITY PROPERTY PROS LLC
VITE_PUBLIC_SUPPORT_EMAIL=hello@example.com

# GitHub Pages base path is set at BUILD time, not here:
#   local / custom domain:  BASE_PATH=/
#   project pages path:     BASE_PATH=/priority-property-pros/

# ---------------------------------------------------------------------------
# Phase 2 — Supabase (PUBLIC)
# Replace these placeholders after you create the project (docs/SUPABASE_SETUP.md).
# Until then the site still builds and the homepage works; login shows “not configured”.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# DO NOT add:
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
# POSTGRES_PASSWORD=
# STRIPE_SECRET_KEY=              # Edge Function secret only; sk_test_ required
# STRIPE_SIGNUP_FEE_WEBHOOK_SECRET=  # Edge Function secret only; not the job-payment webhook

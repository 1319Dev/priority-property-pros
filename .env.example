# Priority Property Pros — public environment placeholders
# Phase 1 is a static site. You do NOT need any secrets to run or deploy it.
# Copy this file to .env if you want to override local values:
#   cp .env.example .env
#
# Never put private API keys, Stripe secrets, or database passwords in this repo.

# Public app labels (safe to expose in the browser)
VITE_PUBLIC_APP_NAME=Priority Property Pros
VITE_PUBLIC_COMPANY_NAME=PRIORITY PROPERTY PROS LLC
VITE_PUBLIC_SUPPORT_EMAIL=hello@example.com

# GitHub Pages base path is set at BUILD time, not here:
#   local / custom domain:  BASE_PATH=/
#   project pages path:     BASE_PATH=/priority-property-pros/
# See README.md and docs/GITHUB_PAGES_SETUP.md

# ---------------------------------------------------------------------------
# Later phases (do not fill with real secrets in git)
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Stripe, auth redirects, and server URLs belong in later phases.
